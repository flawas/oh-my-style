{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "palette": {
    "bg": "#2E3440",
    "bg_light": "#3B4252",
    "fg": "#ECEFF4",
    "muted": "#4C566A",
    "accent": "#88C0D0",
    "warn": "#EBCB8B",
    "danger": "#BF616A"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "╭─",
          "trailing_diamond": "",
          "background": "p:bg",
          "foreground": "p:fg",
          "template": " {{ if .WSL }}WSL {{ end }}{{ .Icon }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:bg_light",
          "foreground": "p:fg",
          "template": " {{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~",
            "folder_icon": "…"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "trailing_diamond": "",
          "background": "p:muted",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:warn{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:danger{{ end }}"
          ],
          "foreground": "p:fg",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:bg{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:fg{{ end }}"
          ],
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} {{ .StashCount }}{{ end }} ",
          "options": {
            "branch_icon": " ",
            "branch_identical_icon": "",
            "branch_ahead_icon": "↑",
            "branch_behind_icon": "↓",
            "branch_gone_icon": "≢"
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:muted",
          "template": " {{ .FormattedMs }} ",
          "options": {
            "threshold": 500
          }
        },
        {
          "type": "shell",
          "style": "plain",
          "foreground": "p:muted",
          "template": " {{ .Name }}",
          "options": {
            "mapped_shell_names": {
              "pwsh": "pwsh",
              "powershell": "ps5"
            }
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:danger{{ end }}"
          ],
          "template": "╰─❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:accent",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:danger{{ end }}"
    ],
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "p:muted",
    "template": "❯❯ "
  }
}
